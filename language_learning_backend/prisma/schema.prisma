generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum LessonStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum VocabularyStatus {
  DRAFT
  ACTIVE
}

enum CurriculumStatus {
  DRAFT
  PUBLISHED
}

enum GrammarStatus {
  DRAFT
  ACTIVE
}

enum QuizStatus {
  DRAFT
  ACTIVE
}

enum QuizQuestionType {
  matching
  sentenceOrder
  missingWord
  listeningInput
  pronunciation
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id                 String                 @id @default(cuid())
  name               String
  email              String                 @unique
  passwordHash       String?
  googleId           String?                @unique
  avatarUrl          String?
  role               UserRole               @default(USER)
  status             UserStatus             @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  lessonProgresses   LessonProgress[]
  questionProgresses UserQuestionProgress[]
  learningProfile    UserLearningProfile?
  studySessions      StudySession[]
}

model Language {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  levels    Level[]
}

model Level {
  id          String       @id @default(cuid())
  name        String
  order       Int
  languageId  String
  language    Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)
  topics      Topic[]
  curriculums Curriculum[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([languageId, order])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id                     String           @id @default(cuid())
  title                  String
  description            String?
  topicId                String
  topic                  Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chapterId              String?
  chapter                Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  orderInChapter         Int?
  status                 LessonStatus     @default(DRAFT)
  durationMinutes        Int?
  thumbnailUrl           String?
  requiresPreviousLesson Boolean          @default(false)
  allowReplay            Boolean          @default(true)
  scheduledAt            DateTime?
  publishedAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  vocabularies           Vocabulary[]
  grammars               Grammar[]
  quiz                   Quiz?
  progressRecords        LessonProgress[]
  studySessions          StudySession[]

  @@unique([chapterId, orderInChapter])
  @@index([topicId])
  @@index([chapterId])
  @@index([status])
}

model Vocabulary {
  id            String           @id @default(cuid())
  term          String
  pronunciation String?
  meaning       String
  wordType      String?
  imageUrl      String?
  audioUrl      String?
  status        VocabularyStatus @default(DRAFT)
  lessonId      String
  lesson        Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([lessonId, term])
  @@index([lessonId])
  @@index([status])
}

model Grammar {
  id             String        @id @default(cuid())
  title          String
  pattern        String
  explanation    String
  example        String?
  exampleMeaning String?
  note           String?
  order          Int
  status         GrammarStatus @default(DRAFT)
  lessonId       String
  lesson         Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([lessonId, title])
  @@unique([lessonId, order])
  @@index([lessonId])
  @@index([status])
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      QuizStatus     @default(DRAFT)
  lessonId    String         @unique
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

model QuizQuestion {
  id                  String                 @id @default(cuid())
  type                QuizQuestionType
  order               Int
  instruction         String
  prompt              String?
  koreanText          String?
  romanization        String?
  translation         String?
  audioUrl            String?
  initialAnswer       String[]               @default([])
  correctAnswer       String[]
  quizId              String
  quiz                Quiz                   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options             QuizOption[]
  userProgressRecords UserQuestionProgress[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([quizId, order])
  @@index([quizId])
  @@index([type])
}

model QuizOption {
  id         String       @id @default(cuid())
  optionKey  String
  text       String
  pairId     String?
  order      Int
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([questionId, optionKey])
  @@unique([questionId, order])
  @@index([questionId])
}

model Curriculum {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      CurriculumStatus @default(DRAFT)
  levelId     String
  level       Level            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([levelId, title])
  @@index([levelId])
  @@index([status])
}

model Chapter {
  id           String     @id @default(cuid())
  title        String
  description  String?
  order        Int
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([curriculumId, order])
  @@unique([curriculumId, title])
  @@index([curriculumId])
}

model LessonProgress {
  id                String               @id @default(cuid())
  userId            String
  lessonId          String
  status            LessonProgressStatus @default(IN_PROGRESS)
  progressPercent   Int                  @default(0)
  totalQuestions    Int                  @default(0)
  answeredQuestions Int                  @default(0)
  correctAnswers    Int                  @default(0)
  startedAt         DateTime             @default(now())
  lastStudiedAt     DateTime             @default(now())
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@index([lessonId])
  @@index([lastStudiedAt])
}

model UserQuestionProgress {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  userAnswer String[] @default([])
  isCorrect  Boolean
  attempts   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([questionId])
}

model UserLearningProfile {
  userId           String   @id
  dailyGoalMinutes Int      @default(15)
  totalExperience  Int      @default(0)
  timezone         String   @default("Asia/Ho_Chi_Minh")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id               String    @id @default(cuid())
  userId           String
  lessonId         String
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  durationSeconds  Int       @default(0)
  experienceEarned Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([lessonId])
}
